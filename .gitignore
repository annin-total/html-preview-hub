# Comprehensive .gitignore for Python and Node.js projects
#
# Sources reviewed 2026-08-08:
# - https://github.com/github/gitignore
# - https://github.com/github/gitignore/tree/main/Global
# - https://www.toptal.com/developers/gitignore
#
# Keep dependency lock files committed for reproducible builds.
# Add framework-specific rules when a project adopts another ecosystem.

###############################################################################
# Secrets and local configuration
###############################################################################

.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local
*.local.*
local/
*/local/
secrets/
*/secrets/
.secrets/
*/.secrets/
credentials/
*/credentials/
.credentials/
*/.credentials/
.direnv/
.envrc
.pypirc
.npmrc.local

# Local AI/editor configuration
.claude/settings.local.json
.ai-config-profile

###############################################################################
# Logs, diagnostics, runtime data, and temporary files
###############################################################################

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

pids/
*.pid
*.pid.lock
*.seed
*.stackdump
nohup.out

*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~

